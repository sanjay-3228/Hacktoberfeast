# Environment variables for the EchoSight Forensics backend

# Job storage directory
JOBS_DIR=./jobs

# Optional Windows path to the folder containing shared FFmpeg DLLs.
# Required by TorchCodec/pyannote when using a non-standard shared FFmpeg install.
# Example (Windows): FFMPEG_DLL_DIR=C:\\path\\to\\ffmpeg\\bin
# FFMPEG_DLL_DIR=

# CORS origins - comma-separated list
# For local development, include the frontend origin
# Example: CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173

# Whisper model configuration
# Default: base (or tiny/small/medium/large-v3)
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_REPETITION_PENALTY=1.1
# Transcription language: auto (default), ta (Tamil), en (English), hi, etc.
WHISPER_LANGUAGE=auto
# Optional: comma-separated vocabulary hints / proper nouns
# WHISPER_HOTWORDS="David Goggins, Can't Hurt Me"

# Embedding model
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Groq LLM configuration for Grounded Evidence Inquiry
# GROQ_API_KEY=gsk_your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_ENABLED=true
# GROQ_TIMEOUT_SEC=30
# GROQ_MAX_TOKENS=1024

# Hugging Face token for pyannote diarization (optional)
# HF_TOKEN=your-token-here

# Optional LLM configuration
# Uncomment and set these if you want LLM-powered Q&A
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_API_KEY=your-api-key-here
# LLM_MODEL=gpt-3.5-turbo

# Azure OpenAI (optional)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_DEPLOYMENT=gpt-4
# AZURE_OPENAI_API_VERSION=2024-10-21
